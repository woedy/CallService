# Database
POSTGRES_DB=callservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Asterisk AMI
ASTERISK_USER=django
ASTERISK_PASSWORD=django_secret

# Celery / Redis (auto-configured via service names in docker-compose)
# CELERY_BROKER_URL=redis://redis:6379/0

# Webhook Security (required in production)
WEBHOOK_SECRET=your-webhook-secret-here

# CORS (comma-separated origins, required in production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
